{
  "name": "cook-smart",
  "version": "2.0.4",
  "private": true,
  "description": "Intelligent Recipe Generation Platform - Transform your available ingredients into personalized meal recommendations",
  "author": {
    "name": "Cook Smart Technologies",
    "email": "services.cooksmart@gmail.com",
    "url": "https://cooksmartapp.com"
  },
  "homepage": "https://cooksmartapp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tootallgames2020/cook-smart.git"
  },
  "bugs": {
    "url": "https://github.com/tootallgames2020/cook-smart/issues",
    "email": "services.cooksmart@gmail.com"
  },
  "license": "PROPRIETARY",
  "keywords": [
    "recipe",
    "cooking",
    "ingredients",
    "meal-planning",
    "react-native",
    "food",
    "nutrition",
    "barcode-scanner"
  ],
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build": "tsc --noEmit && echo Build check passed",
    "build:android": "cd android && ./gradlew assembleRelease --no-daemon",
    "build:android:debug": "cd android && ./gradlew assembleDebug --no-daemon",
    "clean": "cd android && ./gradlew clean && cd .. && npx react-native clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "prepare": "husky install",
    "postinstall": "cd backend && npm install",
    "dev": "concurrently \"npm run start\" \"cd backend && npm run dev\"",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^23.5.0",
    "@react-native-firebase/messaging": "^23.5.0",
    "@react-native/new-app-screen": "0.82.1",
    "@react-navigation/bottom-tabs": "^7.8.4",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/stack": "^7.6.3",
    "axios": "^1.13.2",
    "pg": "^8.16.3",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-camera-kit": "^16.1.3",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-reanimated": "^4.1.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-sound": "^0.13.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.7.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "husky": "^9.1.6",
    "jest": "^29.6.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
