{
  "InstanceIds": ["i-0e2c8623378f172c8"],
  "DocumentName": "AWS-RunShellScript",
  "Parameters": {
    "commands": [
      "echo '=== Cook Smart Clean Repository Deployment ==='",
      "cd /home/ec2-user",
      "echo 'Step 1: Install Node.js from Amazon Linux extras'",
      "amazon-linux-extras install -y nodejs14",
      "echo 'Step 2: Verify Node.js installation'",
      "node --version",
      "npm --version",
      "echo 'Step 3: Install PM2 globally'",
      "npm install -g pm2",
      "echo 'Step 4: Remove old code'",
      "rm -rf cook-smart-old",
      "mv cook-smart cook-smart-old 2>/dev/null || echo 'No existing cook-smart directory'",
      "echo 'Step 5: Clone fresh repository from main branch'",
      "git clone https://github.com/tootallgames2020/cook-smart.git",
      "cd cook-smart",
      "git checkout fresh-project-migration || git checkout main",
      "echo 'Step 6: Navigate to backend'",
      "cd backend",
      "ls -la",
      "echo 'Step 7: Setup environment'",
      "cp .env.example .env",
      "sed -i 's/localhost/cook-smart-db-beta.cgfwigy2i9lk.us-east-1.rds.amazonaws.com/g' .env",
      "sed -i 's/cook-smart/cooksmartadmin/g' .env",
      "echo 'Step 8: Install dependencies'",
      "npm install",
      "echo 'Step 9: Build TypeScript'",
      "npm run build",
      "echo 'Step 10: Stop any existing PM2 processes'",
      "pm2 delete all || echo 'No existing PM2 processes'",
      "echo 'Step 11: Start backend server'",
      "pm2 start dist/server.js --name cook-smart-backend",
      "pm2 save",
      "pm2 startup",
      "echo 'Step 12: Verify deployment'",
      "sleep 10",
      "pm2 status",
      "curl -s http://localhost:3000/health",
      "echo 'Step 13: Test auth endpoint'",
      "curl -X POST -H 'Content-Type: application/json' -d '{\"email\":\"test@test.com\",\"password\":\"test\"}' http://localhost:3000/api/v1/auth/login",
      "echo '=== Deployment Complete ==='",
      "echo 'Backend should now be running with latest clean code!'"
    ]
  }
}