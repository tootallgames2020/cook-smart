{
  "InstanceIds": ["i-06366021916987eda"],
  "DocumentName": "AWS-RunShellScript",
  "Parameters": {
    "commands": [
      "echo '=== Manual Ubuntu Backend Setup ==='",
      "cd /home/ubuntu",
      "echo 'Step 1: Install Node.js 20 LTS'",
      "curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -",
      "sudo apt-get install -y nodejs",
      "echo 'Step 2: Verify Node.js installation'",
      "node --version",
      "npm --version",
      "echo 'Step 3: Install PM2 globally'",
      "sudo npm install -g pm2",
      "echo 'Step 4: Clone fresh code if not exists'",
      "if [ ! -d 'cook-smart' ]; then",
      "  git clone https://github.com/tootallgames2020/cook-smart.git",
      "fi",
      "cd cook-smart",
      "git checkout fresh-project-migration",
      "echo 'Step 5: Setup backend'",
      "cd backend",
      "cp .env.example .env",
      "sed -i 's/your-database-host/cook-smart-db-beta.cgfwigy2i9lk.us-east-1.rds.amazonaws.com/g' .env",
      "sed -i 's/your-db-user/cooksmartadmin/g' .env",
      "sed -i 's/your-db-password/CookSmart2024!/g' .env",
      "sed -i 's/your-jwt-secret/cook-smart-jwt-secret-2024/g' .env",
      "echo 'Step 6: Install dependencies and build'",
      "npm install",
      "npm run build",
      "echo 'Step 7: Start backend with PM2'",
      "pm2 delete all || echo 'No existing processes'",
      "pm2 start dist/server.js --name cook-smart-backend",
      "pm2 save",
      "pm2 startup",
      "echo 'Step 8: Test backend'",
      "sleep 5",
      "pm2 status",
      "curl -s http://localhost:3000/health || echo 'Health check failed'",
      "echo 'Step 9: Setup nginx (basic config)'",
      "sudo apt-get install -y nginx",
      "sudo systemctl start nginx",
      "sudo systemctl enable nginx",
      "echo 'Step 10: Create basic nginx config'",
      "sudo tee /etc/nginx/sites-available/cook-smart > /dev/null <<EOF",
      "server {",
      "    listen 80;",
      "    server_name api.cooksmartapp.com;",
      "    location / {",
      "        proxy_pass http://localhost:3000;",
      "        proxy_set_header Host \\$host;",
      "        proxy_set_header X-Real-IP \\$remote_addr;",
      "        proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;",
      "        proxy_set_header X-Forwarded-Proto \\$scheme;",
      "    }",
      "}",
      "EOF",
      "sudo ln -sf /etc/nginx/sites-available/cook-smart /etc/nginx/sites-enabled/",
      "sudo rm -f /etc/nginx/sites-enabled/default",
      "sudo nginx -t && sudo systemctl reload nginx",
      "echo '=== Setup Complete ==='",
      "echo 'Testing final endpoint...'",
      "curl -s http://localhost/health || echo 'Final test failed'"
    ]
  }
}