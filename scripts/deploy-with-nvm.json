{
  "InstanceIds": ["i-0e2c8623378f172c8"],
  "DocumentName": "AWS-RunShellScript",
  "Parameters": {
    "commands": [
      "echo '=== Cook Smart NVM Node.js Deployment ==='",
      "cd /home/ec2-user",
      "echo 'Step 1: Install Node.js using NVM (compatible with older glibc)'",
      "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash",
      "export NVM_DIR=\"$HOME/.nvm\"",
      "[ -s \"$NVM_DIR/nvm.sh\" ] && \\. \"$NVM_DIR/nvm.sh\"",
      "[ -s \"$NVM_DIR/bash_completion\" ] && \\. \"$NVM_DIR/bash_completion\"",
      "nvm install 16.20.2",
      "nvm use 16.20.2",
      "nvm alias default 16.20.2",
      "echo 'Step 2: Verify Node.js installation'",
      "node --version",
      "npm --version",
      "echo 'Step 3: Install PM2 globally'",
      "npm install -g pm2",
      "echo 'Step 4: Navigate to fresh code'",
      "cd cook-smart/backend",
      "pwd",
      "ls -la",
      "echo 'Step 5: Setup environment file'",
      "cp .env.example .env",
      "sed -i 's/your-database-host/cook-smart-db-beta.cgfwigy2i9lk.us-east-1.rds.amazonaws.com/g' .env",
      "sed -i 's/your-db-user/cooksmartadmin/g' .env",
      "sed -i 's/your-db-password/CookSmart2024!/g' .env",
      "sed -i 's/your-jwt-secret/cook-smart-jwt-secret-2024/g' .env",
      "echo 'Step 6: Install backend dependencies'",
      "npm install",
      "echo 'Step 7: Build TypeScript'",
      "npm run build",
      "ls -la dist/",
      "echo 'Step 8: Stop any existing PM2 processes'",
      "pm2 delete all || echo 'No existing PM2 processes'",
      "echo 'Step 9: Start backend server'",
      "pm2 start dist/server.js --name cook-smart-backend",
      "pm2 save",
      "echo 'Step 10: Verify deployment'",
      "sleep 5",
      "pm2 status",
      "pm2 logs cook-smart-backend --lines 10",
      "echo 'Step 11: Test endpoints'",
      "curl -s http://localhost:3000/health",
      "echo ''",
      "curl -X POST -H 'Content-Type: application/json' -d '{\"email\":\"test@test.com\",\"password\":\"test\"}' http://localhost:3000/api/v1/auth/login",
      "echo ''",
      "echo '=== Deployment Complete ==='",
      "echo 'Backend should now be running with NVM Node.js and fresh code!'"
    ]
  }
}