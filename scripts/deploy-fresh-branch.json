{
  "InstanceIds": ["i-0e2c8623378f172c8"],
  "DocumentName": "AWS-RunShellScript",
  "Parameters": {
    "commands": [
      "echo '=== Cook Smart Fresh Branch Deployment ==='",
      "cd /home/ec2-user",
      "echo 'Step 1: Install Node.js 18 (Amazon Linux 2 method)'",
      "curl -fsSL https://rpm.nodesource.com/setup_18.x | sudo bash -",
      "sudo yum install -y nodejs",
      "echo 'Step 2: Verify Node.js installation'",
      "node --version",
      "npm --version",
      "echo 'Step 3: Install PM2 globally'",
      "sudo npm install -g pm2",
      "echo 'Step 4: Remove old code and backup'",
      "sudo rm -rf cook-smart-backup",
      "sudo mv cook-smart cook-smart-backup 2>/dev/null || echo 'No existing cook-smart directory'",
      "echo 'Step 5: Clone fresh repository with correct branch'",
      "git clone https://github.com/tootallgames2020/cook-smart.git",
      "cd cook-smart",
      "git checkout fresh-project-migration",
      "echo 'Step 6: Navigate to backend and check structure'",
      "cd backend",
      "ls -la",
      "echo 'Step 7: Setup environment file'",
      "cp .env.example .env",
      "sed -i 's/your-database-host/cook-smart-db-beta.cgfwigy2i9lk.us-east-1.rds.amazonaws.com/g' .env",
      "sed -i 's/your-db-user/cooksmartadmin/g' .env",
      "sed -i 's/your-db-password/CookSmart2024!/g' .env",
      "sed -i 's/your-jwt-secret/cook-smart-jwt-secret-2024/g' .env",
      "echo 'Step 8: Install backend dependencies'",
      "npm install",
      "echo 'Step 9: Build TypeScript'",
      "npm run build",
      "ls -la dist/",
      "echo 'Step 10: Stop any existing PM2 processes'",
      "pm2 delete all || echo 'No existing PM2 processes'",
      "echo 'Step 11: Start backend server'",
      "pm2 start dist/server.js --name cook-smart-backend",
      "pm2 save",
      "echo 'Step 12: Verify deployment'",
      "sleep 5",
      "pm2 status",
      "pm2 logs cook-smart-backend --lines 10",
      "echo 'Step 13: Test endpoints'",
      "curl -s http://localhost:3000/health || echo 'Health endpoint failed'",
      "curl -X POST -H 'Content-Type: application/json' -d '{\"email\":\"test@test.com\",\"password\":\"test\"}' http://localhost:3000/api/v1/auth/login || echo 'Auth endpoint test failed'",
      "echo '=== Deployment Complete ==='",
      "echo 'Backend should now be running with fresh-project-migration branch code!'"
    ]
  }
}